<section id="education" class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4">
        {# Section header #}
        <div class="text-center mb-16" data-aos="fade-up">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">{{ 'education.title'|trans }}</h2>
            <p class="text-text-secondary">{{ 'education.subtitle'|trans }}</p>
            <div class="w-20 h-1 gradient-bg mx-auto mt-4 rounded-full"></div>
        </div>
 
        {# Education cards #}
        <div class="grid md:grid-cols-3 gap-6">
            {% set edu_icons = ['graduation-cap', 'book-open', 'school'] %}
            {% for i in 1..3 %}
                <div class="bg-bg-card rounded-xl p-8 card-glow hover:-translate-y-2 transition-transform duration-300 relative overflow-hidden group"
                     data-aos="flip-up" data-aos-delay="{{ i * 150 }}">
                    {# Gradient top border #}
                    <div class="absolute top-0 left-0 right-0 h-1 gradient-bg"></div>
 
                    <div class="w-14 h-14 rounded-xl bg-primary/10 flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
                        <i data-lucide="{{ edu_icons[i-1] }}" class="w-7 h-7 text-primary"></i>
                    </div>
 
                    {% if i == 1 %}
                        <span class="inline-block px-3 py-1 rounded-full text-xs font-medium gradient-bg text-white mb-4">
                            {{ 'education.1.status'|trans }}
                        </span>
                    {% endif %}
 
                    <h3 class="text-lg font-semibold mb-2">{{ ('education.' ~ i ~ '.institution')|trans }}</h3>
                    <p class="text-primary text-sm font-medium mb-2">{{ ('education.' ~ i ~ '.degree')|trans }}</p>
 
                    <div class="flex items-center gap-2 text-text-secondary text-sm">
                        <i data-lucide="calendar" class="w-4 h-4"></i>
                        <span>{{ ('education.' ~ i ~ '.period')|trans }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>