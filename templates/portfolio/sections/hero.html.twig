<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
    {# Animated gradient background #}
    <div class="absolute inset-0 bg-gradient-to-br from-bg-dark via-bg-dark to-primary/10 pointer-events-none"></div>

    {# Decorative blobs #}
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/5 rounded-full blur-3xl animate-float pointer-events-none"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent/5 rounded-full blur-3xl animate-float pointer-events-none" style="animation-delay:1.5s"></div>

    {# Floating code snippets #}
    <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-10 select-none hidden lg:block" aria-hidden="true">
        <span class="absolute top-28 left-12 text-primary font-mono text-sm animate-bounce" style="animation-duration:3s">&lt;?php</span>
        <span class="absolute top-48 right-16 text-accent font-mono text-xs animate-bounce" style="animation-duration:4s">{ }</span>
        <span class="absolute bottom-48 left-16 text-primary font-mono text-xs animate-bounce" style="animation-duration:5s">function()</span>
        <span class="absolute bottom-28 right-12 text-accent font-mono text-sm animate-bounce" style="animation-duration:3.5s">&lt;/div&gt;</span>
        <span class="absolute top-64 left-1/3 text-primary font-mono text-xs animate-bounce" style="animation-duration:4.5s">const dev = true;</span>
        <span class="absolute bottom-64 right-1/3 text-accent font-mono text-xs animate-bounce" style="animation-duration:2.5s">SELECT * FROM skills;</span>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto px-4 text-center">

        {# Profile photo with gradient ring #}
        <div data-aos="zoom-in" data-aos-duration="800" class="mb-8">
            <div class="inline-block p-1 rounded-full" style="background: linear-gradient(135deg, #6C63FF, #3B82F6, #6C63FF); background-size: 200%;">
                <div class="w-32 h-32 md:w-40 md:h-40 rounded-full overflow-hidden bg-bg-dark flex items-center justify-center">
                    <img src="{{ asset('images/profile.jpg') }}"
                         alt="Photo de {{ name }}"
                         class="w-full h-full object-cover object-top"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                    <div class="w-full h-full gradient-bg items-center justify-center text-white text-4xl font-bold hidden" aria-hidden="true">
                        AKJ
                    </div>
                </div>
            </div>
            {# Online badge #}
            <div class="flex items-center justify-center gap-2 mt-3">
                <span class="w-2.5 h-2.5 bg-green-400 rounded-full animate-pulse inline-block"></span>
                <span class="text-green-400 text-sm font-medium">Disponible</span>
            </div>
        </div>

        {# Greeting #}
        <p data-aos="fade-up" data-aos-delay="100" class="text-text-secondary text-lg md:text-xl mb-4 font-mono tracking-wider uppercase text-sm">
            {{ 'hero.greeting'|trans }}
        </p>

        {# Name #}
        <h1 data-aos="fade-up" data-aos-delay="200" class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
            <span class="gradient-text">{{ name }}</span>
        </h1>

        {# Typing effect #}
        <div data-aos="fade-up" data-aos-delay="400" class="text-xl md:text-2xl text-text-secondary mb-8 min-h-[2.5rem] flex items-center justify-center gap-2">
            <span class="text-primary font-mono">&gt;</span>
            <span class="typing-text font-medium"
                  data-texts='{{ ["typed.1"|trans, "typed.2"|trans, "typed.3"|trans, "typed.4"|trans]|json_encode }}'></span>
            <span class="inline-block w-0.5 h-6 bg-primary animate-pulse align-middle ml-0.5"></span>
        </div>

        {# Description #}
        <p data-aos="fade-up" data-aos-delay="600" class="text-text-secondary max-w-2xl mx-auto mb-10 leading-relaxed text-base md:text-lg">
            {{ 'hero.description'|trans }}
        </p>

        {# CTA buttons #}
        <div data-aos="fade-up" data-aos-delay="800" class="flex flex-col sm:flex-row gap-4 justify-center mb-10">
            <a href="#contact"
               class="gradient-bg text-white px-8 py-3 rounded-full font-semibold hover:scale-105 transition-transform duration-300 shadow-lg shadow-primary/25 flex items-center justify-center gap-2">
                <i data-lucide="mail" class="w-5 h-5"></i>
                {{ 'hero.cta.contact'|trans }}
            </a>
            <a href="#projects"
               class="border-2 border-primary/40 text-primary px-8 py-3 rounded-full font-semibold hover:bg-primary/10 hover:border-primary hover:scale-105 transition-all duration-300 flex items-center justify-center gap-2">
                <i data-lucide="folder-open" class="w-5 h-5"></i>
                {{ 'nav.projects'|trans }}
            </a>
        </div>

        {# Social links #}
        <div data-aos="fade-up" data-aos-delay="900" class="flex justify-center gap-4">
            <a href="mailto:justamnkaj@gmail.com"
               class="w-11 h-11 rounded-full bg-white/5 border border-white/10 hover:border-primary/50 hover:bg-primary/10 flex items-center justify-center text-text-secondary hover:text-primary transition-all duration-300 hover:scale-110"
               title="Email">
                <i data-lucide="mail" class="w-5 h-5"></i>
            </a>
            <a href="tel:54509044"
               class="w-11 h-11 rounded-full bg-white/5 border border-white/10 hover:border-primary/50 hover:bg-primary/10 flex items-center justify-center text-text-secondary hover:text-primary transition-all duration-300 hover:scale-110"
               title="Téléphone">
                <i data-lucide="phone" class="w-5 h-5"></i>
            </a>
            <a href="https://www.linkedin.com/in/justin-amani-b61233287/" target="_blank" rel="noopener noreferrer"
               class="w-11 h-11 rounded-full bg-white/5 border border-white/10 hover:border-primary/50 hover:bg-primary/10 flex items-center justify-center text-text-secondary hover:text-primary transition-all duration-300 hover:scale-110"
               title="LinkedIn">
                <i data-lucide="linkedin" class="w-5 h-5"></i>
            </a>
            <a href="https://github.com/JustinAmani" target="_blank" rel="noopener noreferrer"
               class="w-11 h-11 rounded-full bg-white/5 border border-white/10 hover:border-primary/50 hover:bg-primary/10 flex items-center justify-center text-text-secondary hover:text-primary transition-all duration-300 hover:scale-110"
               title="GitHub">
                <i data-lucide="github" class="w-5 h-5"></i>
            </a>
        </div>
    </div>

    {# Scroll indicator #}
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
        <a href="#about" class="text-text-secondary hover:text-primary transition-colors" aria-label="{{ 'hero.scroll'|trans }}">
            <i data-lucide="chevrons-down" class="w-6 h-6"></i>
        </a>
    </div>
</section>
