<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Portfolio de Amani Kajemba Justin - Ingénieur Logiciel Junior spécialisé en PHP/Symfony et React Native">

    <title>{% block title %}Amani Kajemba Justin | Portfolio{% endblock %}</title>

    {# Favicon - initials as SVG data URI #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%234A3F8F'/><text x='50' y='68' font-family='Arial' font-weight='bold' font-size='38' fill='white' text-anchor='middle'>AKJ</text></svg>">

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">

    {# AOS CSS #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"/>

    {# Lucide Icons #}
    <script src="https://unpkg.com/lucide@latest" defer></script>

    {# Tailwind + App CSS via Vite #}
    {{ vite_entry_link_tags('app') }}

    <style>
        body { font-family: 'Inter', sans-serif; background-color: #0f0f1a; color: #e2e8f0; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Poppins', sans-serif; }
    </style>
</head>

<body class="bg-bg-dark text-text-primary antialiased">

    {# Navigation #}
    <nav id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 md:h-20">

                <a href="#hero" class="text-xl font-bold gradient-text font-mono">&lt;AKJ/&gt;</a>

                <div class="hidden md:flex items-center space-x-8">
                    <a href="#about"      class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.about'|trans }}</a>
                    <a href="#skills"     class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.skills'|trans }}</a>
                    <a href="#experience" class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.experience'|trans }}</a>
                    <a href="#education"  class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.education'|trans }}</a>
                    <a href="#projects"   class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.projects'|trans }}</a>
                    <a href="#contact"    class="nav-link text-text-secondary hover:text-primary text-sm">{{ 'nav.contact'|trans }}</a>

                    {# Language dropdown — desktop #}
                    <div class="relative" id="lang-dropdown-desktop">
                        <button onclick="document.getElementById('lang-menu-desktop').classList.toggle('hidden')"
                                class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-primary/30 text-primary hover:bg-primary/10 text-sm transition-colors duration-200">
                            <i data-lucide="languages" class="w-4 h-4"></i>
                            {{ app.request.locale|upper }}
                            <i data-lucide="chevron-down" class="w-3 h-3"></i>
                        </button>
                        <div id="lang-menu-desktop" class="hidden absolute right-0 mt-2 w-32 rounded-xl border border-primary/20 bg-bg-dark shadow-lg shadow-black/40 overflow-hidden z-50">
                            <a href="{{ path('app_portfolio', {'_locale': 'fr'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'fr' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇫🇷 Français
                            </a>
                            <a href="{{ path('app_portfolio', {'_locale': 'en'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'en' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇬🇧 English
                            </a>
                            <a href="{{ path('app_portfolio', {'_locale': 'sw'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'sw' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇹🇿 Swahili
                            </a>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:hidden">
                    {# Language dropdown — mobile #}
                    <div class="relative" id="lang-dropdown-mobile">
                        <button onclick="document.getElementById('lang-menu-mobile').classList.toggle('hidden')"
                                class="flex items-center gap-1 px-2.5 py-1 rounded-full border border-primary/30 text-primary text-sm transition-colors duration-200 hover:bg-primary/10">
                            {{ app.request.locale|upper }}
                            <i data-lucide="chevron-down" class="w-3 h-3"></i>
                        </button>
                        <div id="lang-menu-mobile" class="hidden absolute right-0 mt-2 w-32 rounded-xl border border-primary/20 bg-bg-dark shadow-lg shadow-black/40 overflow-hidden z-50">
                            <a href="{{ path('app_portfolio', {'_locale': 'fr'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'fr' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇫🇷 Français
                            </a>
                            <a href="{{ path('app_portfolio', {'_locale': 'en'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'en' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇬🇧 English
                            </a>
                            <a href="{{ path('app_portfolio', {'_locale': 'sw'}) }}"
                               class="flex items-center gap-2 px-4 py-2.5 text-sm hover:bg-primary/10 transition-colors {{ app.request.locale == 'sw' ? 'text-primary font-semibold' : 'text-text-secondary' }}">
                                🇹🇿 Swahili
                            </a>
                        </div>
                    </div>
                    <button id="mobile-menu-btn" class="text-text-primary" aria-label="Menu">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>

            <div id="mobile-menu" class="hidden md:hidden pb-4 border-t border-primary/10">
                <div class="flex flex-col space-y-3 pt-4">
                    <a href="#about"      class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.about'|trans }}</a>
                    <a href="#skills"     class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.skills'|trans }}</a>
                    <a href="#experience" class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.experience'|trans }}</a>
                    <a href="#education"  class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.education'|trans }}</a>
                    <a href="#projects"   class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.projects'|trans }}</a>
                    <a href="#contact"    class="nav-link text-text-secondary hover:text-primary text-sm px-2">{{ 'nav.contact'|trans }}</a>
                </div>
            </div>
        </div>
    </nav>

    {% block body %}{% endblock %}

    {# Back to top #}
    <button id="back-to-top"
            class="fixed bottom-8 right-8 w-12 h-12 rounded-full gradient-bg text-white flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 hover:scale-110 shadow-lg shadow-primary/25"
            aria-label="{{ 'footer.back_to_top'|trans }}">
        <i data-lucide="chevron-up" class="w-5 h-5"></i>
    </button>

    {# AOS JS #}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>

    {# App JS via Vite #}
    {{ vite_entry_script_tags('app') }}

</body>
</html>
